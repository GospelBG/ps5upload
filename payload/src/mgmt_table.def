/* The AVA1 management table: one line per method (P3 Task 2; Tasks 4-9 add the rest).
 *
 *   MGMT_H0(method, ftx2_frame, ftx2_ack, flags, handler, runner)   handler(state, fd, trace_id)
 *   MGMT_HS(method, ftx2_frame, ftx2_ack, flags, handler, runner)   handle_status_frame(state, fd, hdr, scratch, cap)
 *   MGMT_H1(method, ftx2_frame, ftx2_ack, flags, handler, runner)   handler(state, fd, trace_id, body, len)
 *
 * `method` is the AVA1_METHOD_* name (it names the generated wrapper, so use the bare
 * constant), `flags` is 0 or MGMT_SONY (the handler reaches register.c, profile.c,
 * sys_registry.c, remoteplay.c, notif.c or a Sony API; the code takes sony_api_lock /
 * g_register_lock itself, the table only records it and tools/mgmt_audit.py sony checks it), and `runner` is a
 * helper from mgmt_rpc.h: mgmt_call_text (MgmtText in and out), mgmt_call_paged (a
 * MgmtText method that pages with offset/limit/more) or a typed one (mgmt_call_fs_mkdir).
 *
 * The handler is the FTX2 one in runtime.c, unchanged; this file is included twice by
 * runtime.c (wrappers, then the table) and parsed by the ava1-ctest table tests, so keep
 * every entry on one line.
 */
MGMT_H0(AVA1_METHOD_FS_VOLUMES, FTX2_FRAME_FS_LIST_VOLUMES, FTX2_FRAME_FS_LIST_VOLUMES_ACK, 0, handle_fs_list_volumes, mgmt_call_text)
MGMT_H1(AVA1_METHOD_FS_MKDIR, FTX2_FRAME_FS_MKDIR, FTX2_FRAME_FS_MKDIR_ACK, 0, handle_fs_mkdir, mgmt_call_fs_mkdir)
MGMT_H1(AVA1_METHOD_APP_LAUNCH, FTX2_FRAME_APP_LAUNCH, FTX2_FRAME_APP_LAUNCH_ACK, MGMT_SONY, handle_app_launch, mgmt_call_text)
MGMT_H1(AVA1_METHOD_APP_LIST, FTX2_FRAME_APP_LIST_REGISTERED, FTX2_FRAME_APP_LIST_REGISTERED_ACK, MGMT_SONY, handle_app_list_registered, mgmt_call_paged)
MGMT_H0(AVA1_METHOD_PROC_PROCESS_LIST, FTX2_FRAME_PROCESS_LIST, FTX2_FRAME_PROCESS_LIST_ACK, 0, handle_process_list, mgmt_call_text)
MGMT_HS(AVA1_METHOD_NODE_STATUS, FTX2_FRAME_STATUS, FTX2_FRAME_STATUS_ACK, 0, handle_status_frame, mgmt_call_node_status)
/* ---- P3 Task 6: apps, install and launch, processes, saves, media, search index (Sony-lock group) ---- */
MGMT_H1(AVA1_METHOD_APP_REGISTER, FTX2_FRAME_APP_REGISTER, FTX2_FRAME_APP_REGISTER_ACK, MGMT_SONY, handle_app_register, mgmt_call_text)
MGMT_H1(AVA1_METHOD_APP_UNREGISTER, FTX2_FRAME_APP_UNREGISTER, FTX2_FRAME_APP_UNREGISTER_ACK, MGMT_SONY, handle_app_unregister, mgmt_call_text)
MGMT_H0(AVA1_METHOD_APP_LAUNCH_BROWSER, FTX2_FRAME_APP_LAUNCH_BROWSER, FTX2_FRAME_APP_LAUNCH_BROWSER_ACK, MGMT_SONY, handle_app_launch_browser, mgmt_call_text)
MGMT_H1(AVA1_METHOD_APP_LIFECYCLE, FTX2_FRAME_APP_LIFECYCLE, FTX2_FRAME_APP_LIFECYCLE_ACK, MGMT_SONY, handle_app_lifecycle, mgmt_call_text)
MGMT_H1(AVA1_METHOD_APP_INFO_QUERY, FTX2_FRAME_APPINFO_QUERY, FTX2_FRAME_APPINFO_QUERY_ACK, 0, handle_appinfo_query, mgmt_call_text)
MGMT_H1(AVA1_METHOD_APP_INFO_SET, FTX2_FRAME_APPINFO_SET, FTX2_FRAME_APPINFO_SET_ACK, 0, handle_appinfo_set, mgmt_call_text)
MGMT_H0(AVA1_METHOD_APP_DB_QUERY, FTX2_FRAME_APPDB_QUERY, FTX2_FRAME_APPDB_QUERY_ACK, 0, handle_appdb_query, mgmt_call_text)
MGMT_H0(AVA1_METHOD_PROC_FOCUS, FTX2_FRAME_FOCUS_PROBE, FTX2_FRAME_FOCUS_PROBE_ACK, 0, handle_focus_probe, mgmt_call_text)
MGMT_H1(AVA1_METHOD_PROC_LIST, FTX2_FRAME_PROC_LIST, FTX2_FRAME_PROC_LIST_ACK, 0, handle_proc_list, mgmt_call_text)
MGMT_H1(AVA1_METHOD_PROC_KILL, FTX2_FRAME_PROCESS_KILL, FTX2_FRAME_PROCESS_KILL_ACK, 0, handle_process_kill, mgmt_call_text)
MGMT_H1(AVA1_METHOD_PROC_MODULES, FTX2_FRAME_PROC_MODULES, FTX2_FRAME_PROC_MODULES_ACK, 0, handle_proc_modules, mgmt_call_text)
MGMT_H1(AVA1_METHOD_SAVES_LIST, FTX2_FRAME_LIST_SAVES, FTX2_FRAME_LIST_SAVES_ACK, 0, handle_list_saves, mgmt_call_paged)
MGMT_H0(AVA1_METHOD_SHOTS_LIST, FTX2_FRAME_LIST_SCREENSHOTS, FTX2_FRAME_LIST_SCREENSHOTS_ACK, 0, handle_list_screenshots, mgmt_call_paged)
MGMT_H0(AVA1_METHOD_VIDEOS_LIST, FTX2_FRAME_LIST_VIDEOS, FTX2_FRAME_LIST_VIDEOS_ACK, 0, handle_list_videos, mgmt_call_paged)
MGMT_H1(AVA1_METHOD_INDEX_START, FTX2_FRAME_INDEX_START, FTX2_FRAME_INDEX_START_ACK, 0, handle_index_start, mgmt_call_text)
MGMT_H0(AVA1_METHOD_INDEX_STATUS, FTX2_FRAME_INDEX_STATUS, FTX2_FRAME_INDEX_STATUS_ACK, 0, handle_index_status, mgmt_call_text)
MGMT_H1(AVA1_METHOD_INDEX_SEARCH, FTX2_FRAME_SEARCH_INDEX, FTX2_FRAME_SEARCH_INDEX_ACK, 0, handle_search_index, mgmt_call_text)
MGMT_H0(AVA1_METHOD_INDEX_CANCEL, FTX2_FRAME_INDEX_CANCEL, FTX2_FRAME_INDEX_CANCEL_ACK, 0, handle_index_cancel, mgmt_call_text)
