/* The AVA1 management table: one line per method (P3 Task 2; Tasks 4-9 add the rest).
 *
 *   MGMT_H0(method, ftx2_frame, ftx2_ack, flags, handler, runner)   handler(state, fd, trace_id)
 *   MGMT_HS(method, ftx2_frame, ftx2_ack, flags, handler, runner)   handle_status_frame(state, fd, hdr, scratch, cap)
 *   MGMT_H1(method, ftx2_frame, ftx2_ack, flags, handler, runner)   handler(state, fd, trace_id, body, len)
 *
 * `method` is the AVA1_METHOD_* name (it names the generated wrapper, so use the bare
 * constant), `flags` is 0 or MGMT_SONY (the handler reaches register.c, profile.c,
 * sys_registry.c, remoteplay.c, notif.c or a Sony API; the code takes sony_api_lock /
 * g_register_lock itself, the table only records it and tools/mgmt_audit.py sony checks it), and `runner` is a
 * helper from mgmt_rpc.h: mgmt_call_text (MgmtText in and out), mgmt_call_paged (a
 * MgmtText method that pages with offset/limit/more) or a typed one (mgmt_call_fs_mkdir).
 *
 * The handler is the FTX2 one in runtime.c, unchanged; this file is included twice by
 * runtime.c (wrappers, then the table) and parsed by the ava1-ctest table tests, so keep
 * every entry on one line.
 */
MGMT_H0(AVA1_METHOD_FS_VOLUMES, FTX2_FRAME_FS_LIST_VOLUMES, FTX2_FRAME_FS_LIST_VOLUMES_ACK, 0, handle_fs_list_volumes, mgmt_call_text)
MGMT_H1(AVA1_METHOD_FS_MKDIR, FTX2_FRAME_FS_MKDIR, FTX2_FRAME_FS_MKDIR_ACK, 0, handle_fs_mkdir, mgmt_call_fs_mkdir)
MGMT_H1(AVA1_METHOD_APP_LAUNCH, FTX2_FRAME_APP_LAUNCH, FTX2_FRAME_APP_LAUNCH_ACK, MGMT_SONY, handle_app_launch, mgmt_call_text)
MGMT_H1(AVA1_METHOD_APP_LIST, FTX2_FRAME_APP_LIST_REGISTERED, FTX2_FRAME_APP_LIST_REGISTERED_ACK, MGMT_SONY, handle_app_list_registered, mgmt_call_paged)
MGMT_H0(AVA1_METHOD_PROC_PROCESS_LIST, FTX2_FRAME_PROCESS_LIST, FTX2_FRAME_PROCESS_LIST_ACK, 0, handle_process_list, mgmt_call_text)
MGMT_HS(AVA1_METHOD_NODE_STATUS, FTX2_FRAME_STATUS, FTX2_FRAME_STATUS_ACK, 0, handle_status_frame, mgmt_call_node_status)

/* ---- P3 Task 7: hardware, system, accounts, cheats, mods, notices, Remote Play ----
 * Every method is a MgmtText with the legacy JSON body, and all use mgmt_call_text_keep: a legacy
 * {"ok":false,...} reply travels as the error cause WITH its fields (time.set err_code, ftp.start port,
 * toast code, ...) and the engine turns it back into the body the module parses (call_legacy_ok).
 * MGMT_SONY marks handlers that reach sceUserService/sceRegMgr/Remote Play/notifications; each takes
 * sony_api_lock itself (mgmt_audit.py sonylock checks it) and the dispatcher adds no lock. */
MGMT_H0(AVA1_METHOD_HW_INFO, FTX2_FRAME_HW_INFO, FTX2_FRAME_HW_INFO_ACK, 0, handle_hw_info, mgmt_call_text_keep)
MGMT_H1(AVA1_METHOD_HW_TEMPS, FTX2_FRAME_HW_TEMPS, FTX2_FRAME_HW_TEMPS_ACK, 0, handle_hw_temps, mgmt_call_text_keep)
